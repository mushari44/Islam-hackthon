# Copy to .env and fill in. Never commit .env.

# Claude. Without a key the app runs in "sources-only" mode (no generated text, no photo reading).
ANTHROPIC_API_KEY=
SABEELI_MODEL=claude-opus-5-5
SABEELI_ANSWER_EFFORT=medium
SABEELI_LIGHT_EFFORT=low
# Server-side refusal fallbacks (on by default; set 0 if your account rejects the beta)
SABEELI_FALLBACKS=1
# Force sources-only mode even with a key (tests and offline demos)
SABEELI_OFFLINE=0

# Signs da'i login tokens. Set a long random value in deployment.
SECRET_KEY=change-me

# Local default is SQLite in data/sabeeli.db. For PostgreSQL also install psycopg[binary].
# DATABASE_URL=postgresql+psycopg://user:pass@host/db

# Synthetic demo accounts (khalid, maryam, yusuf, reviewer), groups and meetups.
SEED_DEMO=1
DEMO_PASSWORD=sabeeli-demo

# Calls (WebRTC). STUN works on most networks; add TURN for strict NATs.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Route all audio through TURN so the seeker's and the da'i's IP addresses stay private.
CALL_RELAY_ONLY=0
CALL_WAIT_SECONDS=600

# Seeker questions are deleted after this many hours.
RETENTION_HOURS=24
