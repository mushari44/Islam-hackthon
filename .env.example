# Copy to .env and fill in. Never commit .env.

# Claude. Without a key the app runs in "sources-only" mode (no generated text, no photo reading).
ANTHROPIC_API_KEY=
SABEELI_MODEL=claude-opus-5-5
SABEELI_ANSWER_EFFORT=medium
SABEELI_LIGHT_EFFORT=low
# Server-side refusal fallbacks (on by default; set 0 if your account rejects the beta)
SABEELI_FALLBACKS=1
# Drop any model sentence that cites no approved passage (keep on)
SABEELI_STRICT_GROUNDING=1
SABEELI_MAX_UNCITED_WORDS=6
# Force sources-only mode even with a key (tests and offline demos)
SABEELI_OFFLINE=0

# Semantic search (optional): multilingual E5-large next to BM25, fused with LangChain.
# pip install -r requirements-embeddings.txt, then python scripts/build_embeddings.py
# auto = use the index once it is built; 0 = BM25 only; 1 = like auto, but warn if it can't load
SABEELI_EMBEDDINGS=auto
SABEELI_EMBED_MODEL=intfloat/multilingual-e5-large
# Share of the hybrid ranking from meaning (E5); the rest is BM25
SABEELI_DENSE_WEIGHT=0.7
# SABEELI_EMBED_DEVICE=cuda

# Signs da'i login tokens. Set a long random value in deployment.
SECRET_KEY=change-me

# Local default is SQLite in data/sabeeli.db. For PostgreSQL also install psycopg[binary].
# DATABASE_URL=postgresql+psycopg://user:pass@host/db

# Synthetic demo accounts (khalid, maryam, yusuf, reviewer), groups and meetups.
SEED_DEMO=1
DEMO_PASSWORD=sabeeli-demo

# Calls (WebRTC). STUN works on most networks; add TURN for strict NATs.
STUN_URLS=stun:stun.l.google.com:19302
# One or more TURN addresses, comma separated, e.g. from a free metered.ca account:
# TURN_URL=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# Route all audio through TURN so the seeker's and the da'i's IP addresses stay private.
CALL_RELAY_ONLY=0
CALL_WAIT_SECONDS=600

# IslamHouse API key for the videos section. Leave empty to use the public key from IslamHouse's API docs.
SABEELI_ISLAMHOUSE_KEY=

# Seeker questions are deleted after this many hours.
RETENTION_HOURS=24

# Seeker password resets by email (optional). Without SMTP_HOST, seekers reset with their recovery code.
# Any SMTP service works, e.g. a Gmail address with an app password: smtp.gmail.com, port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
