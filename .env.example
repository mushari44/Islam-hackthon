# Sabeeli settings. Copy this file to .env in the same folder, then edit .env (never commit .env):
#   macOS / Linux:  cp .env.example .env
#   Windows:        copy .env.example .env
# Restart the app after any change (Docker: run the same `docker compose ... up` command again).
#
# Every value below already works as written. For judges, the ONLY line that needs a value is
# OPENROUTER_API_KEY in section 1. Everything else is optional and can stay as it is.
# Check what is on at http://localhost:8000/api/health ("ai": true means AI answers are on).


# =============================================================================
# 1. AI ANSWERS: the one value to fill in
# =============================================================================
# Paste an OpenRouter key after the = sign (no quotes, no spaces). Get one at https://openrouter.ai/keys
# The app then uses Gemma 4 31B for explained answers and for reading photos.
# Left empty, the app still runs in "sources-only" mode: every answer is built from the approved
# sources with citations, but with no generated explanation and no photo reading.
OPENROUTER_API_KEY=

# Leave these as they are.
SABEELI_LLM_PROVIDER=openrouter
SABEELI_MODEL=google/gemma-4-31b-it
# Only OpenRouter providers that don't store or train on prompts (seekers' questions). Keep 1.
SABEELI_OPENROUTER_PRIVATE=1
# Among those, prefer the fastest providers (throughput), the quickest to start (latency) or the cheapest (price).
SABEELI_OPENROUTER_SORT=throughput
# Seconds to wait for the model before giving up on one call.
SABEELI_LLM_TIMEOUT=90

# Or use Claude instead of Gemma: set SABEELI_LLM_PROVIDER=anthropic, SABEELI_MODEL=claude-opus-5-5
# and paste an Anthropic key here (https://console.anthropic.com).
ANTHROPIC_API_KEY=
SABEELI_ANSWER_EFFORT=medium
SABEELI_LIGHT_EFFORT=low
# Claude only: server-side refusal fallbacks (on by default; set 0 if your account rejects the beta).
SABEELI_FALLBACKS=1


# =============================================================================
# 2. SIGN-IN: worth knowing, no change needed
# =============================================================================
# Sample da'i accounts created on the first start: reviewer (admin), khalid, maryam, yusuf.
# They all use this password. Change it if the app will be reachable by other people.
SEED_DEMO=1
DEMO_PASSWORD=123

# Signs da'i sign-in tokens. Empty = a new random key on each start, so da'is just sign in again after
# a restart. To stay signed in across restarts, paste a long random value, e.g. the output of:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=


# =============================================================================
# 3. ANSWER SAFETY: keep as they are
# =============================================================================
# Drop any model sentence that cites no approved passage. Keep 1 (the challenge's scholarly rule).
SABEELI_STRICT_GROUNDING=1
# Short connecting phrases of at most this many words may stay uncited.
SABEELI_MAX_UNCITED_WORDS=6
# 1 forces sources-only mode even with a key (tests and offline demos).
SABEELI_OFFLINE=0
# How many passages retrieval hands to the answer.
SABEELI_TOP_K=8


# =============================================================================
# 4. SEARCH: optional
# =============================================================================
# Hybrid search: the E5-large embedding model next to BM25. Docker: GPU mode (--profile gpu). Without Docker:
#   pip install -r requirements-embeddings.txt, then python scripts/build_embeddings.py
# Needs an NVIDIA GPU with 8 GB of VRAM or more (CUDA build of PyTorch installed first): minutes.
# On a CPU only it takes about 3 HOURS. See README "Run it yourself" (ways 1c and 2).
# auto = use the index once it is built; 0 = BM25 only; 1 = like auto, but warn if it can't load.
SABEELI_EMBEDDINGS=auto
SABEELI_EMBED_MODEL=intfloat/multilingual-e5-large
# Share of the hybrid ranking from meaning (E5); the rest is BM25.
SABEELI_DENSE_WEIGHT=0.7
# The GPU is used by itself when PyTorch sees one; force it with: SABEELI_EMBED_DEVICE=cuda
# SABEELI_EMBED_DEVICE=cuda
# Docker GPU mode only: 1 = with no usable GPU, build the index on the CPU anyway (about 3 HOURS).
SABEELI_INDEX_ON_CPU=0
# Docker GPU mode only: PyTorch's CUDA build. cu128 for RTX 20xx to 50xx; cu126 for older cards (GTX 10xx).
# Change it before building (docker compose --profile gpu up --build sabeeli-gpu).
SABEELI_TORCH_CUDA=cu128


# =============================================================================
# 5. CALLS: optional
# =============================================================================
# Voice calls between a seeker and a da'i use WebRTC. STUN is enough on one machine or most home networks.
STUN_URLS=stun:stun.l.google.com:19302
# Only for calls between strict networks (offices, some mobile carriers): one or more TURN addresses,
# comma separated, e.g. from a free metered.ca account:
# TURN_URL=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
# 1 = route all audio through TURN so the seeker's and the da'i's IP addresses stay private (needs TURN above).
CALL_RELAY_ONLY=0
# How long a seeker waits in the call queue, in seconds.
CALL_WAIT_SECONDS=600


# =============================================================================
# 6. OTHER: optional
# =============================================================================
# IslamHouse API key for the videos section. Empty = the public key from IslamHouse's API docs.
SABEELI_ISLAMHOUSE_KEY=

# Seeker questions are deleted after this many hours.
RETENTION_HOURS=24

# Seeker password-reset emails. Empty SMTP_HOST = no emails; seekers reset with their recovery code.
# Any SMTP service works, e.g. a Gmail address with an app password: smtp.gmail.com, port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Only when the website runs on another address than the API (our Vercel + Render deploy):
# the sites allowed to call this API, comma separated. Not needed locally.
# CORS_ORIGINS=https://sabeeli.vercel.app
# CORS_ORIGIN_REGEX=https://sabeeli-.*\.vercel\.app

# The database. Default: SQLite in data/sabeeli.db. For PostgreSQL also install psycopg[binary].
# DATABASE_URL=postgresql+psycopg://user:pass@host/db

# Docker only: the port on your machine (default 8000). Also works as SABEELI_PORT=8080 docker compose up
# SABEELI_PORT=8000
